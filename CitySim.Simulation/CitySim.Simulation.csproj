<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Arch" Version="2.1.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="TypedArch\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="TypedArch\**" />
  </ItemGroup>

  <Target Name="ValidateArchetypes" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Simulation.Tests\Simulation.Tests.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
    <Exec Command="dotnet test &quot;$(MSBuildThisFileDirectory)..\Simulation.Tests\Simulation.Tests.csproj&quot; --no-build --configuration $(Configuration) --logger &quot;console;verbosity=minimal&quot;"
          ConsoleToMSBuild="true" />
  </Target>

</Project>
